# Local dev: copy to .env.local.  Production: Vercel > Settings > Environment Variables.
GEMINI_API_KEY=
# Postgres connection string (Neon / Supabase). Vercel adds DATABASE_URL automatically when you connect Neon.
DATABASE_URL=
# Optional
GEMINI_MODEL=gemini-3.8-flash
DAILY_LIMIT=150
# DEBUG_ERRORS=1   (show exact Gemini error text in the chat while debugging)
